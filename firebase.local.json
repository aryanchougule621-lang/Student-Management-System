
{
  "functions": {
    "source": "functions",
    "predeploy": ["npm --prefix functions run prepare:shared"]
  },
  "firestore": {
    "database": "(default)",
    "location": "asia-south1",
    "rules": "firestore.local.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.local.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
